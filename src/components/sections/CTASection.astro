---
import { getI18N } from "@/i18n";
import { getLangFromUrl, useTranslatedPath } from "@/i18n/utils";
import { BannerDiscountDesktop, BannerDiscountMobile } from "@public/img/allImages";
import BlockContainer from "@/components/global/BlockContainer.astro";
import BtnLinkCustom from "@/components/extras/BtnLinkCustom";

const { currentLocale } = Astro;
const i18n = getI18N({ currentLocale });

const lang = getLangFromUrl(Astro.url);
const translatePath = useTranslatedPath(lang);
---

<BlockContainer>
    <div class="relative">
        <img
            src={BannerDiscountDesktop.src} 
            alt={i18n.PUERTO_MORELOS_PAGE.CTA_SECTION.TITLE}
            class="hidden lg:block w-full h-auto object-cover object-left rounded-3xl aspect-3/1 z-10 shadow"
        />
        <img
            src={BannerDiscountMobile.src}
            alt={i18n.PUERTO_MORELOS_PAGE.CTA_SECTION.TITLE}
            class="lg:hidden w-full h-auto object-cover object-left rounded-3xl aspect-3/4 z-10 shadow"
        />
        <div class="absolute bottom-13 left-1/2 lg:left-2/9 -translate-x-1/2 z-20">
            <BtnLinkCustom
                client:visible
                text={i18n.PUERTO_MORELOS_PAGE.CTA_SECTION.BUTTON}
                url={translatePath("/snorkel-adventuring-details/")}
                color="secondary"
            />
        </div>
    </div>
</BlockContainer>
